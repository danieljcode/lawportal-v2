exports[`toDiscord on every form > civil-restraining-order > empty, code tables 1`] = `
"────────────────────
**SAN ANDREAS COURT, COUNTY OF:**
BRANCH NAME: __LOS SANTOS__
COURTHOUSE NAME: __SUPERIOR COURT__
────────────────────
